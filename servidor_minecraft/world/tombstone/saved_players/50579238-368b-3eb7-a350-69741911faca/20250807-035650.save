move4:0b,musicoff:1b,musicon:0b,riding:0b,sophisticatedBackpackSettings:{anotherPlayerCanOpen:0b},walktrigger:0.0d},Health:14.85214f,HurtByTimestamp:70876,HurtTime:6s,Inventory:[{Count:1b,Slot:0b,id:"minecraft:diamond_sword",tag:{Damage:89,Enchantments:[{id:"dungeons_plus:strengthen",lvl:3s}]}},{Count:1b,Slot:1b,id:"minecraft:water_bucket"},{Count:1b,Slot:2b,id:"minecraft:iron_pickaxe",tag:{Damage:1}},{Count:1b,Slot:3b,id:"minecraft:bow",tag:{Damage:27}},{Count:1b,Slot:4b,id:"minecraft:iron_axe",tag:{Damage:19}},{Count:7b,Slot:5b,id:"minecraft:bread"},{Count:16b,Slot:7b,id:"minecraft:splash_potion",tag:{Potion:"minecraft:strong_healing"}},{Count:1b,Slot:9b,id:"minecraft:written_book",tag:{author:"NFidusen",display:{Lore:['{"text":"Remember to only read this if you have seen the first part of the book and the second part of the book, the first part is in the spruce forests, and the second part are in the normal oak forests."}'],Name:'{"text":"Book of The vikings"}'},pages:['{"text":"Book of the Vikings.\\n\\n:::::::::::::::::::::::::::::::::::::::::::::::::::::::::\\n\\nNow Their beliefs were deeply rooted in a new form of belief, lead by Ragnarr. They Believed in  the Aesir and Vanir, and saw the divine in the natural world around them."}','{"text":"They practiced rituals that honored the turning of the seasons, they started the belief in the wisdom of Odin, the Allfather. Runes were not mere symbols to them but a language of power and prophecy, each one holding a secret to the workings of the cosmos."}','{"text":"Under the leadership of Ragnarr loðbrók, the Vikings embarked on a journey that would carve their names into the saga of time, as a people who chose their own fate and, in doing so, became both good and evil, but because of their illager roots, and the fact that they did not change their"}','{"text":"Personality, it became nearly as corrupt as their previous people, The illagers, and from there, there came evil monsters, powerful beings and Powerful leaders. But along the way, when all was thougth that there was no hope left, you came."}'],resolved:1b,title:"Book of vikings"}},{Count:3b,Slot:10b,id:"minecraft:coal"},{Count:7b,Slot:11b,id:"minecraft:hay_block"},{Count:24b,Slot:12b,id:"minecraft:stick"},{Count:6b,Slot:13b,id:"minecraft:splash_potion",tag:{Potion:"minecraft:strong_healing"}},{Count:12b,Slot:14b,id:"minecraft:mossy_cobblestone"},{Count:1b,Slot:15b,id:"minecraft:gold_block"},{Count:1b,Slot:16b,id:"minecraft:potato"},{Count:1b,Slot:17b,id:"minecraft:enchanted_book",tag:{StoredEnchantments:[{id:"minecraft:projectile_protection",lvl:3s}]}},{Count:33b,Slot:18b,id:"minecraft:gunpowder"},{Count:5b,Slot:19b,id:"minecraft:apple"},{Count:1b,Slot:20b,id:"minecraft:filled_map",tag:{Decorations:[{id:"+",rot:180.0d,type:26b,x:-1264.0d,z:384.0d}],display:{Lore:['{"translate":"Labyrinth","color":"gray","italic":false}'],MapColor:4554807,Name:'{"translate":"Dungeon Map","color":"#008709","italic":false}'},map:3}},{Count:12b,Slot:21b,id:"minecraft:spruce_planks"},{Count:18b,Slot:22b,id:"minecraft:birch_log"},{Count:1b,Slot:25b,id:"minecraft:iron_leggings",tag:{Damage:30}},{Count:7b,Slot:26b,id:"dungeonnowloading:spawner_frame"},{Count:1b,Slot:28b,id:"minecraft:enchanted_book",tag:{StoredEnchantments:[{id:"mofus_better_end_:ink_recycling",lvl:1s}]}},{Count:1b,Slot:29b,id:"minecraft:music_disc_13"},{Count:1b,Slot:30b,id:"minecraft:bow",tag:{Damage:0}},{Count:2b,Slot:31b,id:"dungeonnowloading:soul_silk"},{Count:64b,Slot:32b,id:"minecraft:tipped_arrow",tag:{Potion:"minecraft:strong_healing"}},{Count:36b,Slot:33b,id:"minecraft:wheat"},{Count:1b,Slot:34b,id:"bosses_of_mass_destruction:soul_star"},{Count:14b,Slot:35b,id:"minecraft:tipped_arrow",tag:{Potion:"minecraft:strong_healing"}},{Count:1b,Slot:100b,id:"dungeonnowloading:spawner_boots",tag:{Damage:75}},{Count:1b,Slot:101b,id:"minecraft:diamond_leggings",tag:{Damage:54,Enchantments:[{id:"minecraft:projectile_protection",lvl:1s}]}},{Count:1b,Slot:102b,id:"dungeonnowloading:sp